.venv/
__pycache__/
*.pyc
.DS_Store
.ipynb_checkpoints/

# Ignore verbose working logs, but track source-of-truth docs (README, CLAUDE.md)
dev_log.md
PIPELINE.md

# paper 3: the 22 MB ragged download is a rebuildable intermediate
# (data/fetch_data.py). panel_prices.parquet IS tracked — it is the analysis
# input, and pinning it keeps results reproducible when Yahoo revises history.
paper3_market_modularity/data/raw_closes.parquet
# paper 3: derived analysis artifacts, all rebuilt by experiments/exp1_data.py
# and exp2_networks.py. edges.npy alone is ~163 MB.
paper3_market_modularity/data/panel_clean.parquet
paper3_market_modularity/data/returns.npy
paper3_market_modularity/data/edges.npy

# paper 3: Phase 3 derived artifacts (rebuilt by experiments/exp3_communities.py)
paper3_market_modularity/data/partitions.npy
paper3_market_modularity/data/mixing.npz

# paper 3: resumable per-chunk caches (Phases 4-5), rebuilt on demand
paper3_market_modularity/results/_chunks_*/

# reports: LaTeX build intermediates (the .tex and .pdf ARE tracked)
reports/*.aux
reports/*.log
reports/*.out
reports/*.toc
reports/*.xdv
reports/*.synctex.gz

# modularity_indicator: derived artifacts. series.parquet and scores_*.csv ARE
# tracked, since they make the report's numbers checkable without re-running the
# solver. These three are redundant or purely local.
modularity_indicator/series.csv
modularity_indicator/figdata.txt
modularity_indicator/figures/
